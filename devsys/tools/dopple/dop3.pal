PAL16L8
DOP3
Dopple Board RAM Array Control PAL
Scott Statton, Developer Resources, Mtn. View, CA

RAMW RAMO TA0 HA0 HDATA TDATA TW0 TW1 PIN9 GND
EIGHTBIT XBUS W0 W1 O0 O1 PIN17 PIN18 PIN19 VCC

/XBUS =		EIGHTBIT * /TDATA * TA0 +
		/HDATA * HA0

/W0 = 		/RAMW * /TDATA * /TA0 * /TW0 * EIGHTBIT +
		/RAMW * /TDATA * /TW0 * /EIGHTBIT +
		/RAMW * /HDATA * /HA0

/W1 =		/RAMW * /TDATA *  TA0 * /TW0 * EIGHTBIT +
		/RAMW * /TDATA * /TW1 * /EIGHTBIT +
		/RAMW * /HDATA *  HA0

/O0 =		/RAMO * /TDATA * /TA0 * EIGHTBIT +
		/RAMO * /TDATA * /EIGHTBIT +
		/RAMO * /HDATA * /HA0

/O1 =		/RAMO * /TDATA *  TA0 * EIGHTBIT +
		/RAMO * /TDATA * /EIGHTBIT +
		/RAMO * /HDATA *  HA0


