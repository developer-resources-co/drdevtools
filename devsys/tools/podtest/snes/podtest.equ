; SPRITES
SPR_BLANK	EQU	16
SPR_STARS	EQU	18
SPR_STARS2	EQU	19
SPR_STARS3	EQU	20
SPR_SWORD	EQU	21
SPR_EXPLOSION	EQU	23


;============================================================================
; HARDWARE

; When reading as 16 bits, value returned is byte swapped

GENIE	DEFS	RAM
GENIE	SEGMENT
	org	0
ghi	ds	2
glo	ds	2
gdata	ds	2
trap_SIZEOF

RD_GENIE_CONTROL	EQU	$FF8000
RD_GENIE_CONTROL8	EQU	$FF8100
RD_GENIE_POWERON	EQU	$FF8002

RD_GENIE_TRAP1HI	EQU	$FF8004
