set virtualxsize 132
set virtualysize 43
set dispmode $100

OPEN MEMORY POSITION 0,1 RESIZE 60,12
NAME MEMORY Diss
Diss DYNAMICR PC

OPEN REGISTER POSITION 60,1
OPEN SYMBOL POSITION 80+25,13 RESIZE 27,9
OPEN BREAK POSITION 58,13 RESIZE 47,9
