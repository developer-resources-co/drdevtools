;==============================================================================
; joystick equates
;----------------------------------------------------------------------------
; Bit 0 = up / Bit 1 = Down / Bit 2 = Left / Bit 3 = Right
; Bit 4 = B  / Bit 5 = C    / Bit 6 = A    / Bit 7 = START

JOYB_UP         EQU     0
JOYB_DOWN       EQU     1
JOYB_LEFT       EQU     2
JOYB_RIGHT      EQU     3
JOYB_B          EQU     4
JOYB_C          EQU     5
JOYB_A          EQU     6
JOYB_START      EQU     7

JOYF_UP         EQU     1
JOYF_DOWN       EQU     2
JOYF_LEFT       EQU     4
JOYF_RIGHT      EQU     8
JOYF_B          EQU     $10
JOYF_C          EQU     $20
JOYF_A          EQU     $40
JOYF_START      EQU     $80

;============================================================================
; vdp equates

CHARSIZE	EQU     32
CHARNUMCOLS	EQU	16			; number of colors per character
VDPSIZE		EQU	$10000


VDP_REG0	EQU	$8000
VDP_REG1	EQU	$8100
VDP_REG2	EQU	$8200
VDP_REG3	EQU	$8300
VDP_REG4	EQU	$8400
VDP_REG5	EQU	$8500
VDP_REG6	EQU	$8600
VDP_REG7	EQU	$8700
VDP_REG8	EQU	$8800
VDP_REG9	EQU	$8900
VDP_REG10	EQU	$8A00
VDP_REG11	EQU	$8B00
VDP_REG12	EQU	$8C00
VDP_REG13	EQU	$8D00
VDP_REG14	EQU	$8E00
VDP_REG15	EQU	$8F00
VDP_REG16	EQU	$9000
VDP_REG17	EQU	$9100
VDP_REG18	EQU	$9200
VDP_REG19	EQU	$9300
VDP_REG20	EQU	$9400
VDP_REG21	EQU	$9500
VDP_REG22	EQU	$9600
VDP_REG23	EQU	$9700

;------------------------------------------------------------------------------

VDP_REG_MODESET1	EQU	$8000
VDP_REG_MODESET2       	EQU	$8100
VDP_REG_FIELDABASE     	EQU	$8200
VDP_REG_WINDOWBASE     	EQU	$8300
VDP_REG_FIELDBBASE     	EQU	$8400
VDP_REG_SPRITEBASE     	EQU	$8500
VDP_REG_BACKCOLOR      	EQU	$8700
VDP_REG_HINTERUPT      	EQU	$8A00
VDP_REG_MODESET3       	EQU	$8B00
VDP_REG_MODESET4       	EQU	$8C00
VDP_REG_HSCROLLBASE    	EQU	$8D00
VDP_REG_AUTOINCSIZE    	EQU	$8F00
VDP_REG_FIELDSIZE     	EQU	$9000
VDP_REG_WINDOWHPOS     	EQU	$9100
VDP_REG_WINDOWVPOS     	EQU	$9200
VDP_REG_DMALENLOW      	EQU	$9300
VDP_REG_DMALENHIGH     	EQU	$9400
VDP_REG_DMASOURCELOW   	EQU	$9500
VDP_REG_DMASOURCEMID  	EQU	$9600
VDP_REG_DMASOURCEHIGH  	EQU	$9700

;------------------------------------------------------------------------------

VDP_DMA_START	EQU	$00000080

VDP_MODE_VRW    EQU     $40000000
VDP_MODE_CRW    EQU     $C0000000
VDP_MODE_VSW    EQU     $40000010
VDP_MODE_VRR    EQU     $00000000
VDP_MODE_CRR    EQU     $00000020
VDP_MODE_VSR    EQU     $00000010

VDP_STATB_PAL   EQU     $0
VDP_STATB_DMA   EQU     $1
VDP_STATB_HB    EQU     $2
VDP_STATB_VB    EQU     $3
VDP_STATB_ODD   EQU     $4
VDP_STATB_C     EQU     $5
VDP_STATB_SOVR  EQU     $6
VDP_STATB_F     EQU     $7
VDP_STATB_FULL  EQU     $8
VDP_STATB_EMPT  EQU     $9

VDP_STATF_PAL   EQU     $1
VDP_STATF_DMA   EQU     $2
